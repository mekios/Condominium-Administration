DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:4200
DEFAULT_LOCALE=el
SUPPORTED_LOCALES=el,en

# Email (invite + receipts). Leave EMAIL_HOST empty for console backend in dev.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@building.local
FRONTEND_LOGIN_URL=http://localhost:8081/login
