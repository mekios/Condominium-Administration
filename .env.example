DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:4200
DEFAULT_LOCALE=el
SUPPORTED_LOCALES=el,en

# Email (invites, password reset, invoices, receipts) via Brevo SMTP.
# Leave the login and SMTP key empty to print mail to the console in dev.
# EMAIL_HOST_USER is the Brevo account email. EMAIL_HOST_PASSWORD is the SMTP key
# (Brevo → SMTP & API), not the account password. DEFAULT_FROM_EMAIL must be a
# sender verified in Brevo.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@building.local
FRONTEND_LOGIN_URL=http://localhost:8081/login
