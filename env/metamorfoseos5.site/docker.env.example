# Docker Compose — project root .env for metamorfoseos5.site
# Copy: cp env/metamorfoseos5.site/docker.env.example .env

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
ALLOWED_HOSTS=metamorfoseos5.site,www.metamorfoseos5.site
CSRF_TRUSTED_ORIGINS=https://metamorfoseos5.site,https://www.metamorfoseos5.site
CORS_ALLOWED_ORIGINS=https://metamorfoseos5.site
TIME_ZONE=Europe/Athens
DEFAULT_LOCALE=el
SUPPORTED_LOCALES=el,en

POSTGRES_DB=flatsadmin
POSTGRES_USER=flatsadmin
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Host nginx proxies the site to 127.0.0.1:3000 and /api /admin /static to 127.0.0.1:8000.
FRONTEND_LOGIN_URL=https://metamorfoseos5.site/login
DEFAULT_FROM_EMAIL=noreply@metamorfoseos5.site

# SMTP (invites and password reset). Leave EMAIL_HOST empty until a provider is ready.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
